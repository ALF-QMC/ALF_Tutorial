     -       G(2,1)*(1 - 8*G(3,4)*G(4,3) - 2*G(4,4) + G(3,3)*(-2 + \
4*G(4,4)))) + 
     -    2*G(1,1)*(-((-1 + 2*G(3,3))*(-1 + 2*G(2,4)*G(4,2))) + 2*G(4,4) + \

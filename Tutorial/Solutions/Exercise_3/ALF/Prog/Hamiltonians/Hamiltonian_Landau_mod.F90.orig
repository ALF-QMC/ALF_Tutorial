          ! Local
          Integer :: I,n,n1,n2,n3,n4,nt,nt1, nc_F, nc_J, nc_h_p, nc_h_m
         

          Delta_S0_global = 1.d0


        end Function Delta_S0_global

!--------------------------------------------------------------------
!> @author 
!> ALF Collaboration
!>
!> @brief 
!> Computes equal time observables
!> @details
!> @param [IN] Gr   Complex(:,:,:)  
!> \verbatim
!>  Green function: Gr(I,J,nf) = <c_{I,nf } c^{dagger}_{J,nf } > on time slice ntau
!> \endverbatim
!> @param [IN] Phase   Complex
!> \verbatim
!>  Phase  
!> \endverbatim
!> @param [IN] Ntau Integer
!> \verbatim
!>  Time slice 
!> \endverbatim
!-------------------------------------------------------------------
        subroutine Obser(GR,Phase,Ntau)
          
          Implicit none
          
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: GR(Ndim,Ndim,N_FL)
          Complex (Kind=Kind(0.d0)), Intent(IN) :: PHASE
          Integer, INTENT(IN)          :: Ntau
          
          !Local 
          Complex (Kind=Kind(0.d0)) :: GRC(Ndim,Ndim,N_FL), GRC_ren(Ndim,Ndim,N_FL), ZK, Zn, tmp, weight, Renyi
          Complex (Kind=Kind(0.d0)) :: Zrho, Zkin, ZPot, Z, ZP,ZS, ZZ, ZXY, ZMz, ZMz2, Zt, Ztp, Ztpp, Ztppp
          Real (Kind=Kind(0.d0))    :: m1, m1p, m1pp, m1ppp
          Integer :: I,J, imj, nf, dec, I1, J1, no_I, no_J,n, K, K1, L, b1, b2, I2, I3, I4
          Integer :: m_ind, m, mp_ind, mp, m1_ind, m1p_ind, t, tp, twos, Sites(ndim)
          Integer :: mpp_ind, mpp, mppp_ind, mppp, m1pp_ind, m1ppp_ind, tpp, tppp
          
          ZP = PHASE/Real(Phase, kind(0.D0))
          ZS = Real(Phase, kind(0.D0))/Abs(Real(Phase, kind(0.D0)))
          
          
          Do nf = 1,N_FL
             Do I = 1,Ndim
                Do J = 1,Ndim
                   GRC(I, J, nf) = -GR(J, I, nf)
                Enddo
                GRC(I, I, nf) = 1.D0 + GRC(I, I, nf)
             Enddo
          Enddo
          ! GRC(i,j,nf) = < c^{dagger}_{j,nf } c_{j,nf } >

          ! Compute scalar observables. 
          Do I = 1,Size(Obs_scal,1)
             Obs_scal(I)%N         =  Obs_scal(I)%N + 1
             Obs_scal(I)%Ave_sign  =  Obs_scal(I)%Ave_sign + Real(ZS,kind(0.d0))
          Enddo
             

          Zkin = cmplx(0.d0, 0.d0, kind(0.D0))
          Do n  = 1,Size(Op_T,1)
             Do nf = 1,N_FL
                Do I = 1,Size(Op_T(n,nf)%O,1)
                   Do J = 1,Size(Op_T(n,nf)%O,2)
                      Zkin = Zkin +  Op_T(n,nf)%O(i, j, 1)*Grc( Op_T(n,nf)%P(I,1), Op_T(n,nf)%P(J,1), nf )
                   ENddo
                Enddo
             Enddo
          Enddo
          Zkin = Zkin * dble(N_SUN)
          Obs_scal(1)%Obs_vec(1)  =    Obs_scal(1)%Obs_vec(1) + Zkin *ZP* ZS

          Zn=cmplx(dble(N_sun),0.d0,kind(0.d0))
          ZPot = cmplx(0.d0, 0.d0, kind(0.D0))
          Do nf = 1,N_FL
            Do n = 1,size(OP_V,1)
              weight=-Op_V(n,nf)%g**2 /dtau
              Do b1=1,2
                Do J = 1,Op_V(n,nf)%N
                  J1 = Op_V(n,nf)%P(J,b1)
                  DO I = 1,Op_V(n,nf)%N
                    if (abs(Op_V(n,nf)%O(i,j,b1)) >= 0.00001) then
                      I1 = Op_V(n,nf)%P(I,b1)
                      ZPot  = ZPot  + 2.d0*Zn*Op_V(n,nf)%alpha*weight*Op_V(n,nf)%O(i,j,b1)*GRC(I1,J1,1)
                      Do b2=1,2
                        Do K = 1,Op_V(n,nf)%N
                          K1 = Op_V(n,nf)%P(K,b2)
                          DO L = 1,Op_V(n,nf)%N
                            if (abs(Op_V(n,nf)%O(k,l,b2)) >= 0.00001) then
                            L1 = Op_V(n,nf)%P(L,b2)
                            tmp =  (   GRC(I1,L1,1) * GR (J1,K1,1)      +  &
                                  &    Zn * GRC(I1,J1,1) * GRC(K1,L1,1)         )
                            ZPot  = ZPot  + weight*Op_V(n,nf)%O(i,j,b1)*Op_V(n,nf)%O(k,l,b2)*tmp
                            endif
                          Enddo
                        ENddo
                      enddo
                    endif
                  Enddo
                ENddo
              enddo
              ZPot  = ZPot  + weight*(Op_V(n,nf)%alpha**2)*Zn
            Enddo
          Enddo
          Obs_scal(2)%Obs_vec(1)  =  Obs_scal(2)%Obs_vec(1) + Zn * Zpot * ZP*ZS


          Zrho = cmplx(0.d0,0.d0, kind(0.D0))
          Do nf = 1,N_FL
             Do I = 1,Ndim
                Zrho = Zrho + Grc(i,i,nf) 
             enddo
          enddo
          Zrho = Zrho* dble(N_SUN)
          Obs_scal(3)%Obs_vec(1)  =    Obs_scal(3)%Obs_vec(1) + Zrho * ZP*ZS

          Obs_scal(4)%Obs_vec(1)  =    Obs_scal(4)%Obs_vec(1) + (Zkin + Zn*Zpot)*ZP*ZS

          twos=nint(2*ham_s)
          ZMz = cmplx(0.d0, 0.d0, kind(0.D0))
          Zt=-1.d0
          Z =  cmplx(dble(N_SUN), 0.d0, kind(0.D0))
!           write(*,*) "m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW"
          Do t = 1,2
            Zt=-Zt
            Ztp=-1.d0
            Do tp = 1,2
              Ztp=-Ztp
              Do m_ind  = 1,Size(BetaW,1)
                m = m_ind - twos -1
                Do m1_ind = max(1,m_ind-twos),min(Size(BetaW,2),m_ind)
                  m1 = m1_ind - 1.0 - ham_s
                  Do m1p_ind = max(1,m_ind-twos),min(Size(BetaW,3),m_ind)
                    m1p = m1p_ind - 1.0 - ham_s
!                     write(*,*) m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW(m_ind,m1_ind,m1p_ind)
                    ZMz = ZMz + Zt*Ztp* BetaW(m_ind,m1_ind,m1p_ind)*&
                        &(Z*Z*Grc( eff_index(m1,t) ,  eff_index(m1-m,t)  , 1 ) &
                            & *Grc( eff_index(m1p-m,tp) ,  eff_index(m1p,tp)  , 1 ) + &
                            &Z*Grc( eff_index(m1,t) ,  eff_index(m1p,tp)  , 1 ) &
                            & *Gr( eff_index(m1-m,t) ,  eff_index(m1p-m,tp)  , 1 ) )
                  enddo
                ENddo
              Enddo
            Enddo
          Enddo
          Obs_scal(5)%Obs_vec(1)  =    Obs_scal(5)%Obs_vec(1) + ZMz *ZP* ZS
          
          
          ZMz = cmplx(0.d0, 0.d0, kind(0.D0))
          Zt=-1.d0
          Z =  cmplx(dble(N_SUN), 0.d0, kind(0.D0))
!           write(*,*) "m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW"
          Do t = 1,2
            Zt=-Zt
            Ztp=-1.d0
            Do tp = 1,2
              Ztp=-Ztp
              Do m1_ind  = 1,twos+1
                m1 = m1_ind - 1.0 - ham_s
                I1=eff_index(m1,t)
                Do m1p_ind = 1,twos+1
                  m1p = m1p_ind - 1.0 - ham_s
                  J1=eff_index(m1p,tp)
                  ZMz = ZMz + Zt*Ztp* &
                      &( Z*Z*Grc( I1 ,  I1  , 1 ) * Grc( J1 ,  J1  , 1 ) + &
                          &Z*Grc( I1 ,  J1  , 1 ) * Gr ( I1 ,  J1  , 1 ) )
                enddo
              Enddo
            Enddo
          Enddo
          Obs_scal(6)%Obs_vec(1)  =    Obs_scal(6)%Obs_vec(1) + ZMz *ZP* ZS
          
          !binder
          
          
          ZMz2 = cmplx(0.d0, 0.d0, kind(0.D0))
          Zt=-1.d0
          Z =  cmplx(dble(N_SUN), 0.d0, kind(0.D0))
!           write(*,*) "m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW"
          Do t = 1,2
            Zt=-Zt
            Ztp=-1.d0
            Do tp = 1,2
              Ztp=-Ztp
              Ztpp=-1.d0
              Do tpp = 1,2
                Ztpp=-Ztpp
                Ztppp=-1.d0
                Do tppp = 1,2
                  Ztppp=-Ztppp
                  Do m1_ind  = 1,twos+1
                    m1 = m1_ind - 1.0 - ham_s
                    I1=eff_index(m1,t)
                    Do m1p_ind = 1,twos+1
                      m1p = m1p_ind - 1.0 - ham_s
                      I2=eff_index(m1p,tp)
                      Do m1pp_ind  = 1,twos+1
                        m1pp = m1pp_ind - 1.0 - ham_s
                        I3=eff_index(m1pp,tpp)
                        Do m1ppp_ind = 1,twos+1
                          m1ppp = m1ppp_ind - 1.0 - ham_s
                          I4=eff_index(m1ppp,tppp)
                          ZMz2 = ZMz2 + Zt*Ztp*Ztpp*Ztppp* binder(Gr(:,:,1),Grc(:,:,1),I1,I2,I3,I4)
                        enddo
                      Enddo
                    Enddo
                  Enddo
                enddo
              Enddo
            Enddo
          Enddo
          Obs_scal(8)%Obs_vec(1)  =    Obs_scal(8)%Obs_vec(1) + ZMz2 *ZP* ZS
          Obs_scal(8)%Obs_vec(2)  =    Obs_scal(8)%Obs_vec(2) + ZMz *ZP* ZS
          
          
          !   #ENT#
          GRC_ren = 0.25d0*GRC
          do i=1,size(GRC,1)
            Sites(i)=i
          enddo
          call Calc_Renyi_Ent(GRC_ren,Phase,Ntau,Sites,Ndim,Renyi)
          Obs_scal(9)%Obs_vec(1)  =    Obs_scal(9)%Obs_vec(1) + Renyi**N_SUN *ZP* ZS

          ! checking that <n_{l,m} n_{l,m}> = 0. first try l = 1, m = 1.
          twos=nint(2*ham_s)
          ZMz = cmplx(0.d0, 0.d0, kind(0.D0))
          Zt=-1.d0
          Z =  cmplx(dble(N_SUN), 0.d0, kind(0.D0))
!           write(*,*) "m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW"
          Do t = 1,2
            Zt=-Zt
            Ztp=-1.d0
            Do tp = 1,2
               Ztp=-Ztp
               m_ind = 2
               m = m_ind - twos - 1
               mp_ind = 2
               mp = mp_ind - twos - 1
              !Do m_ind  = 1,Size(BetaW,1)
                !m = m_ind - twos -1
                Do m1_ind = max(1,m_ind-twos),min(Size(BetaW,2),m_ind)
                  m1 = m1_ind - 1.0 - ham_s
                  Do m1p_ind = max(1,mp_ind-twos),min(Size(BetaW,3),mp_ind)
                    m1p = m1p_ind - 1.0 - ham_s
                    ! write(*,*) m_ind, m, m1_ind, m1, m1p_ind, m1p, Zt*Ztp* BetaW(m_ind,m1_ind,m1p_ind)
                    ZMz = ZMz + Zt*Ztp*alpha(1,twos+1+m,m1_ind) &
                         & *alpha(1,twos+1+mp,m1p_ind)*&
                        &(Z*Z*Grc( eff_index(m1,t) ,  eff_index(m1-m,t)  , 1 ) &
                            & *Grc( eff_index(m1p,tp) ,  eff_index(m1p-mp,tp)  , 1 ) + &
                            &Z*Grc( eff_index(m1,t) ,  eff_index(m1p-mp,tp)  , 1 ) &
                            & *Gr( eff_index(m1-m,t) ,  eff_index(m1p,tp)  , 1 ) )
                  enddo
                ENddo
              !Enddo
            Enddo
          Enddo
          Obs_scal(7)%Obs_vec(1)  =    Obs_scal(7)%Obs_vec(1) + ZMz *ZP* ZS
          
          ! Compute spin-spin, Green, and den-den correlation functions  !  This is general N_SUN, and  N_FL = 1
          DO I = 1,Size(Obs_eq,1)
             Obs_eq(I)%N        = Obs_eq(I)%N + 1
             Obs_eq(I)%Ave_sign = Obs_eq(I)%Ave_sign + real(ZS,kind(0.d0))
          ENDDO 
          Z =  cmplx(dble(N_SUN), 0.d0, kind(0.D0))
          Do I1 = 1,Ndim
            I    = 1
            no_I = I1
            Do J1 = 1,Ndim
                J    = 1
                no_J = J1
                imj = latt%imj(I,J)
                ! Green
                Obs_eq(1)%Obs_Latt(imj,1,no_I,no_J) =  Obs_eq(1)%Obs_Latt(imj,1,no_I,no_J) + &
                    &               Z * GRC(I1,J1,1) *  ZP*ZS 
                ! SpinZ
                Obs_eq(2)%Obs_Latt(imj,1,no_I,no_J) =  Obs_eq(2)%Obs_Latt(imj,1,no_I,no_J) + &
                    &               Z * GRC(I1,J1,1) * GR(I1,J1,1) * ZP*ZS
                ! SpinXY
                Obs_eq(3)%Obs_Latt(imj,1,no_I,no_J) =  Obs_eq(3)%Obs_Latt(imj,1,no_I,no_J) + &
                    &               Z * GRC(I1,J1,1) * GR(I1,J1,1) * ZP*ZS
                ! SpinT
                Obs_eq(5)%Obs_Latt(imj,1,no_I,no_J) =  Obs_eq(5)%Obs_Latt(imj,1,no_I,no_J) + &
                    &               Z * GRC(I1,J1,1) * GR(I1,J1,1) * ZP*ZS
                ! Den
                Obs_eq(4)%Obs_Latt(imj,1,no_I,no_J) =  Obs_eq(4)%Obs_Latt(imj,1,no_I,no_J)  +  &
                    &     (    GRC(I1,I1,1) * GRC(J1,J1,1) *Z     + &
                    &          GRC(I1,J1,1) * GR(I1,J1,1 )           &
                    &                                   ) * Z* ZP*ZS
            ENDDO
            Obs_eq(4)%Obs_Latt0(no_I) =  Obs_eq(4)%Obs_Latt0(no_I) +  Z * GRC(I1,I1,1) * ZP * ZS
          ENDDO
                

        end Subroutine Obser
!--------------------------------------------------------------------
!> @author 
!> ALF Collaboration
!>
!> @brief 
!> Computes time displaced  observables
!> @details
!> @param [IN] NT, Integer
!> \verbatim
!>  Imaginary time
!> \endverbatim
!> @param [IN] GT0, GTT, G00, GTT,  Complex(:,:,:)  
!> \verbatim
!>  Green functions:
!>  GT0(I,J,nf) = <T c_{I,nf }(tau) c^{dagger}_{J,nf }(0  )> 
!>  G0T(I,J,nf) = <T c_{I,nf }(0  ) c^{dagger}_{J,nf }(tau)> 
!>  G00(I,J,nf) = <T c_{I,nf }(0  ) c^{dagger}_{J,nf }(0  )> 
!>  GTT(I,J,nf) = <T c_{I,nf }(tau) c^{dagger}_{J,nf }(tau)> 
!> \endverbatim
!> @param [IN] Phase   Complex
!> \verbatim
!>  Phase  
!> \endverbatim
!-------------------------------------------------------------------
        Subroutine ObserT(NT,  GT0,G0T,G00,GTT, PHASE)
          Implicit none
          
          Integer         , INTENT(IN) :: NT
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: GT0(Ndim,Ndim,N_FL),G0T(Ndim,Ndim,N_FL),G00(Ndim,Ndim,N_FL),GTT(Ndim,Ndim,N_FL)
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: Phase
          
          !Locals
          Complex (Kind=Kind(0.d0)) :: Z, ZP, ZS, kron, kronp, kronpp, Zt, Ztp, Ztpp, Ztppp, tmp, tmp2, tmp3, tmp4, bg, bg2
          Real (Kind=Kind(0.d0))    :: m1, m1p, m1pp, m1ppp
          Integer :: IMJ, I, J, I1, J1, no_I, no_J, K, t, tp, tpp, tppp, m1_ind, m1p_ind, m1pp_ind, m1ppp_ind, m, mp, mpp, mppp, twos
          Integer :: coordX(4), coordY(4)
          Complex (Kind=Kind(0.d0)) :: Delta(Ndim,Ndim)

          Delta=0.d0
          DO I = 1,Ndim
             Delta(I,I)=1.d0
          enddo

          ZP = PHASE/Real(Phase, kind(0.D0))
          ZS = Real(Phase, kind(0.D0))/Abs(Real(Phase, kind(0.D0)))
          If (NT == 0 ) then 
             DO I = 1,Size(Obs_tau,1)
                Obs_tau(I)%N = Obs_tau(I)%N + 1
                Obs_tau(I)%Ave_sign = Obs_tau(I)%Ave_sign + Real(ZS,kind(0.d0))
             ENDDO
          endif
          Z =  cmplx(dble(N_SUN),0.d0, kind(0.D0))
          Do I1 = 1,Ndim
            I    = 1
            no_I = I1
            Do J1 = 1,Ndim
                J    = 1
                no_J = J1
                imj = latt%imj(I,J)
                ! Green
                Obs_tau(1)%Obs_Latt(imj,nt+1,no_I,no_J) =  Obs_tau(1)%Obs_Latt(imj,nt+1,no_I,no_J)  &
                    & +  Z * GT0(I1,J1,1) * ZP* ZS
                
                ! SpinZ
                Obs_tau(2)%Obs_Latt(imj,nt+1,no_I,no_J) =  Obs_tau(2)%Obs_Latt(imj,nt+1,no_I,no_J)  &
                    &      - Z*G0T(J1,I1,1) * GT0(I1,J1,1) *ZP*ZS
                
                ! SpinXY
                Obs_tau(3)%Obs_Latt(imj,nt+1,no_I,no_J) =  Obs_tau(3)%Obs_Latt(imj,nt+1,no_I,no_J)  &
                    &      - Z*G0T(J1,I1,1) * GT0(I1,J1,1) *ZP*ZS
                
                ! Den
                Obs_tau(4)%Obs_Latt(imj,nt+1,no_I,no_J) =  Obs_tau(4)%Obs_Latt(imj,nt+1,no_I,no_J)  &
                    & + ( Z*Z*(cmplx(1.d0,0.d0,kind(0.d0)) - GTT(I1,I1,1))*       &
                    &         (cmplx(1.d0,0.d0,kind(0.d0)) - G00(J1,J1,1))  -     &
                    &     Z * GT0(I1,J1,1)*G0T(J1,I1,1)                                ) * ZP * ZS
             Enddo
             Obs_tau(4)%Obs_Latt0(no_I) = Obs_tau(4)%Obs_Latt0(no_I) + &
                  &         Z*(cmplx(1.d0,0.d0,kind(0.d0)) - GTT(I1,I1,1)) * ZP * ZS

          enddo
          
          if (ham_ltau > 0) then
            ! <n_{l,0}(\tau) n_{l,0}(0)>
            twos = nint(2*ham_s)
            I1 = 1
            I  = 1
            no_I = I1
            J1 = 1
            J = 1
            no_J = J1
            imj = latt%imj(I,J)
            Do K = 5, 4+twos+1
              Zt=-1.d0
              Do t = 1,2
                Zt=-Zt
                Ztp=-1.d0
                Do tp = 1,2
                  Ztp=-Ztp
                  m = 0
                  mp = 0
                  Do m1_ind = 1,twos+1
                    m1 = m1_ind - 1.0 - ham_s
                    Do m1p_ind = 1, twos+1
                      m1p = m1p_ind - 1.0 - ham_s
                      if(eff_index(m1,t) == eff_index(m1-m,t)) then
                        kron = cmplx(1.d0,0.d0,kind(0.d0))
                      else
                        kron = cmplx(0.d0,0.d0,kind(0.d0))
                      endif
                      if(eff_index(m1p,tp) == eff_index(m1p-mp,tp)) then
                        kronp = cmplx(1.d0,0.d0,kind(0.d0))
                      else
                        kronp = cmplx(0.d0,0.d0,kind(0.d0))
                     endif
                      tmp=alpha(K-4,twos+1+m,m1_ind)&
                            & * alpha(K-4,twos+1+mp,m1p_ind)&
                            &* ( Z*Z*(kron -  GTT( eff_index(m1,t) , eff_index(m1-m,t), 1) )* &
                            &        (kronp - G00( eff_index(m1p,tp) , eff_index(m1p-mp,tp), 1) ) ) * ZP * ZS
                      tmp2=alpha(K-4,twos+1+m,m1_ind)&
                            & * alpha(K-4,twos+1+mp,m1p_ind)&
                            &* ( -Z*GT0( eff_index(m1,t) , eff_index(m1p-mp,tp) , 1)* &
                            &       G0T( eff_index(m1p,tp) , eff_index(m1-m,t), 1 ) ) * ZP * ZS
                      Obs_tau(K)%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K)%Obs_Latt(imj,nt+1,no_I,no_J) &
                            &+ (tmp + tmp2)
                      Obs_tau(K+twos+1)%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K+twos+1)%Obs_Latt(imj,nt+1,no_I,no_J) &
                            &+ Zt*Ztp*( tmp + tmp2)
                      if (ham_ltau > 1) then
                        Obs_tau(K+2*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K+2*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J)&
                            &+ tmp2
                        Obs_tau(K+3*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K+3*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J)&
                            &+ Zt*Ztp*tmp2
                     endif
                     if (ham_ltau > 2) then
                        tpp  = 3 - t
                        tppp = 3 - tp
!                              if(eff_index(m1,t) == eff_index(m1p-mp,tppp)) then
!                                 kronpp = cmplx(1.d0,0.d0,kind(0.d0))
!                              else
!                                 kronpp = cmplx(0.d0,0.d0,kind(0.d0))
!                              endif
                        tmp3=alpha(K-4,twos+1+m,m1_ind)&
                                & * alpha(K-4,twos+1+mp,m1p_ind)&
                                &* ( Z*Z*GTT( eff_index(m1,t) , eff_index(m1-m,tpp), 1) * &
                                &        G00( eff_index(m1p,tp) , eff_index(m1p-mp,tppp), 1) ) * ZP * ZS
                        tmp4=alpha(K-4,twos+1+m,m1_ind)&
                                & * alpha(K-4,twos+1+mp,m1p_ind)&
                                &* ( -Z*(GT0( eff_index(m1,t) , eff_index(m1p-mp,tppp), 1)) * &
                                &        G0T( eff_index(m1p,tp) , eff_index(m1-m,tpp), 1) ) * ZP * ZS
                        Obs_tau(K + 4*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K + 4*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) &
                            &+ (tmp3 + tmp4)
                        Obs_tau(K + 5*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K + 5*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) &
                            &- Zt*Ztp*(tmp3 + tmp4)
                        Obs_tau(K + 6*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K + 6*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) &
                            &+ tmp4
                        Obs_tau(K + 7*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) = Obs_tau(K + 7*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) &
                             &- Zt*Ztp*tmp4
                        if (ham_ltau > 3) then
                           Obs_tau(K + 8*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J)&
                                &= Obs_tau(K + 8*(twos+1))%Obs_Latt(imj, nt+1,no_I,no_J) + (tmp3 + tmp4)
                        endif
                     endif
                     if(ham_ltau > 3) then
                        mpp = 0
                        Ztpp=-1.d0
                        Do tpp = 1,2
                           Ztpp=-Ztpp
                           Do m1pp_ind = 1, twos+1
                              m1pp = m1pp_ind - 1.0 - ham_s
                              coordX(1) = eff_index(m1,t)
                              coordX(2) = eff_index(m1p,tp)
                              coordX(3) = eff_index(m1pp,tpp)
                              coordY(1) = eff_index(m1-m,t)
                              coordY(2) = eff_index(m1p-mp,tp)
                              coordY(3) = eff_index(m1pp-mpp,3-tpp)
                              tmp = ZZ_X(G00(:,:,1),G0T(:,:,1),GT0(:,:,1),GTT(:,:,1),Delta,coordX,coordY)
                              tmp = tmp * Zt * Ztp * alpha(K-4,twos+1+m,m1_ind) *&
                                   &alpha(1,twos+1+mp,m1p_ind) * alpha(K-4, twos+1+mpp,m1pp_ind)
                              Obs_tau(K + 8*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) =&
                                   &Obs_tau(K + 8*(twos+1))%Obs_Latt(imj, nt+1,no_I,no_J) - tmp
                              mppp = 0
                              Ztppp=-1.d0
                              Do tppp = 1,2
                                 Ztppp=-Ztppp
                                 Do m1ppp_ind = 1, twos+1
                                    m1ppp = m1ppp_ind - 1.0 - ham_s
                                    coordY(3) = eff_index(m1pp-mpp,tpp)
                                    coordX(4) = eff_index(m1ppp,tppp)
                                    coordY(4) = eff_index(m1ppp-mppp,tppp)
                                    tmp = ZZ_ZZ(G00(:,:,1),G0T(:,:,1),GT0(:,:,1),GTT(:,:,1),Delta,coordX,coordY)
                                    tmp = tmp * Zt * Ztp * Ztpp * Ztppp * alpha(K-4,twos+1+m,m1_ind) * alpha(1,twos+1+mp,m1p_ind)&
                                         &* alpha(K-4, twos+1+mpp,m1pp_ind) * alpha(1,twos+1+mppp,m1ppp_ind)
                                    Obs_tau(K + 8*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) =&
                                         &Obs_tau(K + 8*(twos+1))%Obs_Latt(imj, nt+1,no_I,no_J) + tmp
                                 enddo
                              enddo
                              coordY(1) = eff_index(m1-m,3-t)
                              tmp = X_ZZ(G00(:,:,1),G0T(:,:,1),GT0(:,:,1),GTT(:,:,1),Delta,coordX,coordY)
                              tmp = tmp * Ztp * Ztpp * alpha(K-4,twos+1+m,m1_ind) *&
                                   &alpha(K-4,twos+1+mp,m1p_ind) * alpha(1, twos+1+mpp,m1pp_ind)
                              Obs_tau(K + 8*(twos+1))%Obs_Latt(imj,nt+1,no_I,no_J) =&
                                   &Obs_tau(K + 8*(twos+1))%Obs_Latt(imj, nt+1,no_I,no_J) - tmp
                           enddo
                        enddo
                     endif
                  enddo
                  !There is only a bg if l=0 (rotational symmetry)
                  if ( K == 5 ) then
                     bg = alpha(K-4,twos+1+m,m1_ind)&
                          &* Z*(kron -  GTT( eff_index(m1,t) , eff_index(m1-m,t), 1) )* ZP * ZS
                     !n^00 has the total number of particles as a background
                     Obs_tau(K)%Obs_Latt0(no_I) = Obs_tau(K)%Obs_Latt0(no_I) + bg*0.5d0
                     !n^0z cannot have a background due to the symmetry
                     !                           Obs_tau(K+twos+1)%Obs_Latt0(no_I) = Obs_tau(K+twos+1)%Obs_Latt0(no_I) + Zt * bg
                     if (ham_ltau > 2) then
                        bg2 = - alpha(K-4,twos+1+m,m1_ind)&
<<<<<<< HEAD
                             &*  Z*GTT( eff_index(m1,t) , eff_index(m1-m,tp), 1) * ZP * ZS  !ATTENTION doublecheck second eff_index, is it t or tp (there was a bug using tpp)
=======
                             &*  Z*GTT( eff_index(m1,t) , eff_index(m1-m,tp), 1) * ZP * ZS
>>>>>>> Ising_Landau_levels_sphere
                        ! n^x0 can have a background if the transverse field is non-zero
                        Obs_tau(K + 4*(twos+1))%Obs_Latt0(no_I) = Obs_tau(K + 4*(twos+1))%Obs_Latt0(no_I) + bg2*0.5d0
                        !n^xz cannot have a background due to the symmetry
                        !                               Obs_tau(K + 5*(twos+1))%Obs_Latt0(no_I) = Obs_tau(K + 5*(twos+1))%Obs_Latt0(no_I) + Zt * bg2
                     endif
                  endif
               enddo
            enddo
         enddo
      enddo
   endif
          
end Subroutine OBSERT

!========================================================== 
        
        Complex (Kind=Kind(0.d0)) function ZZ_X(G00,G0T,GT0,GTT,Delta,coordX,coordY)

          Implicit none

          Integer,  Intent(In) ::  coordX(4), coordY(4)
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: G00(Ndim,Ndim), G0T(Ndim,Ndim), GT0(Ndim,Ndim), GTT(Ndim,Ndim)          
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: Delta(Ndim,Ndim)
          
          
          include 'ZZ_X.F90'
          
        end function

!==========================================================

!========================================================== 
        
        Complex (Kind=Kind(0.d0)) function ZZ_ZZ(G00,G0T,GT0,GTT,Delta,coordX,coordY)

          Implicit none

          Integer,  Intent(In) ::  coordX(4), coordY(4)
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: G00(Ndim,Ndim), G0T(Ndim,Ndim), GT0(Ndim,Ndim), GTT(Ndim,Ndim)          
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: Delta(Ndim,Ndim)
          
          
          include 'ZZ_ZZ.F90'
          
        end function

!==========================================================

!========================================================== 
        
        Complex (Kind=Kind(0.d0)) function X_ZZ(G00,G0T,GT0,GTT,Delta,coordX,coordY)

          Implicit none

          Integer,  Intent(In) ::  coordX(4), coordY(4)
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: G00(Ndim,Ndim), G0T(Ndim,Ndim), GT0(Ndim,Ndim), GTT(Ndim,Ndim)          
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: Delta(Ndim,Ndim)
          
          
          include 'X_ZZ.F90'
          
        end function

!========================================================== 
! the function binder returns the expectation value <n_I1 n_I_2 n_I3 n_I4>
! with the proper N_SUN facotors for N=2 as it is here
! This corresponds to a basic building block for <Mz^4>
!========================================================== 
        
        Complex (Kind=Kind(0.d0)) function Binder(GR,GRC,I1,I2,I3,I4)

          Implicit none

          Integer,  Intent(In) ::  I1,I2,I3,I4
          Complex (Kind=Kind(0.d0)), INTENT(IN) :: GR(Ndim,Ndim), GRC(Ndim,Ndim)
          
          
          binder=2*(2*GR(I1,I4)*GR(I2,I3)*GRC(I1,I4)*GRC(I2,I3) + &
&          2*GR(I2,I3)*GR(I3,I4)*GRC(I1,I1)*GRC(I2,I4) - &
&          GR(I1,I4)*GR(I2,I3)*GRC(I1,I3)*GRC(I2,I4) + &
&          4*GR(I1,I4)*GRC(I1,I4)*GRC(I2,I2)*GRC(I3,I3) + &
&          4*GR(I2,I4)*GRC(I1,I1)*GRC(I2,I4)*GRC(I3,I3) - &
&          2*GR(I1,I4)*GRC(I1,I2)*GRC(I2,I4)*GRC(I3,I3) + &
&          4*GR(I3,I4)*GRC(I1,I1)*GRC(I2,I2)*GRC(I3,I4) - &
&          2*GR(I1,I4)*GRC(I1,I3)*GRC(I2,I2)*GRC(I3,I4) - &
&          2*GR(I2,I4)*GRC(I1,I1)*GRC(I2,I3)*GRC(I3,I4) + &
&          GR(I1,I4)*GRC(I1,I2)*GRC(I2,I3)*GRC(I3,I4) + &
&          4*GRC(I1,I1)*(GR(I2,I3)*GRC(I2,I3) + 2*GRC(I2,I2)*GRC(I3,I3))* &
&          GRC(I4,I4) + GR(I1,I3)*(GR(I3,I4)* &
&              (2*GRC(I1,I4)*GRC(I2,I2) - GRC(I1,I2)*GRC(I2,I4)) + &
&            GR(I2,I4)*(-(GRC(I1,I4)*GRC(I2,I3)) + 2*GRC(I1,I3)*GRC(I2,I4)) + &
&            2*(2*GRC(I1,I3)*GRC(I2,I2) - GRC(I1,I2)*GRC(I2,I3))*GRC(I4,I4)) + &
&          GR(I1,I2)*(GR(I2,I4)*(2*GRC(I1,I4)*GRC(I3,I3) - GRC(I1,I3)*GRC(I3,I4)) + &
&            GR(I2,I3)*(GR(I3,I4)*GRC(I1,I4) + 2*GRC(I1,I3)*GRC(I4,I4)) + &
&            2*GRC(I1,I2)*(GR(I3,I4)*GRC(I3,I4) + 2*GRC(I3,I3)*GRC(I4,I4))))
          
        end function

!========================================================== 


!--------------------------------------------------------------------
!> @author 
!> ALF Collaboration
!>
!> @brief 
!> Prints out the bins.  No need to change this routine.
!-------------------------------------------------------------------
        Subroutine  Pr_obs(LTAU)

          Implicit none

          Integer,  Intent(In) ::  Ltau
          
          !Local 
          Integer :: I


          Do I = 1,Size(Obs_scal,1)
             Call  Print_bin_Vec(Obs_scal(I),Group_Comm)
          enddo
          Do I = 1,Size(Obs_eq,1)
             Call  Print_bin_Latt(Obs_eq(I),Latt,dtau,Group_Comm)
          enddo
          If (Ltau  == 1 ) then
             Do I = 1,Size(Obs_tau,1)
                Call  Print_bin_Latt(Obs_tau(I),Latt,dtau,Group_Comm)
             enddo
          endif

        end Subroutine Pr_obs

!--------------------------------------------------------------------
!> @author 
!> ALF Collaboration
!>
!> @brief 
!> Initializes observables to zero before each bins.  No need to change
!> this routine.
!-------------------------------------------------------------------
        Subroutine  Init_obs(Ltau) 

          Implicit none
          Integer, Intent(In) :: Ltau
          
          ! Local 
          Integer :: I

          Do I = 1,Size(Obs_scal,1)
             Call Obser_vec_Init(Obs_scal(I))
          Enddo

          Do I = 1,Size(Obs_eq,1)
             Call Obser_Latt_Init(Obs_eq(I))
          Enddo

          If (Ltau == 1) then
             Do I = 1,Size(Obs_tau,1)
                Call Obser_Latt_Init(Obs_tau(I))
             Enddo
          Endif

        end Subroutine Init_obs

!--------------------------------------------------------------------
!> @author 
!> ALF Collaboration
!>
!> @brief
!> Specify a global move on a given time slice tau.
!>
!> @details
!> @param[in] ntau Integer
!> \verbatim
!>  Time slice
!> \endverbatim
!> @param[out] T0_Proposal_ratio, Real
!> \verbatim
!>  T0_Proposal_ratio = T0( sigma_new -> sigma ) /  T0( sigma -> sigma_new)
!> \endverbatim
!> @param[out] S0_ratio, Real
!> \verbatim
!>  S0_ratio = e^( S_0(sigma_new) ) / e^( S_0(sigma) )
!> \endverbatim
!> @param[out] Flip_length  Integer
!> \verbatim
!>  Number of flips stored in the first  Flip_length entries of the array Flip_values.
!>  Has to be smaller than NDIM
!> \endverbatim
!> @param[out] Flip_list  Integer(Ndim)
!> \verbatim
!>  List of spins to be flipped: nsigma%f(Flip_list(1),ntau) ... nsigma%f(Flip_list(Flip_Length),ntau)
!>  Note that Ndim = size(Op_V,1)
!> \endverbatim
!> @param[out] Flip_value  Real(Ndim)
!> \verbatim
!>  Flip_value(:)= nsigma%flip(Flip_list(:),ntau)
!>  Note that Ndim = size(Op_V,1)
!> \endverbatim
!--------------------------------------------------------------------
        Subroutine Global_move_tau(T0_Proposal_ratio, S0_ratio, &
             &                     Flip_list, Flip_length,Flip_value,ntau)

          
          Implicit none 
          Real (Kind = Kind(0.d0)),INTENT(OUT) :: T0_Proposal_ratio,  S0_ratio
          Integer                , INTENT(OUT) :: Flip_list(:)
          Real (Kind = Kind(0.d0)),INTENT(OUT) :: Flip_value(:)
          Integer, INTENT(OUT) :: Flip_length
          Integer, INTENT(IN)    :: ntau


          ! Local
          Integer :: n_op, n, ns
          Real (Kind=Kind(0.d0)) :: T0_proposal

          
          
        end Subroutine Global_move_tau


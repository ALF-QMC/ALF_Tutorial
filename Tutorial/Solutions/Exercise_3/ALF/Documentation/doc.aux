\BKM@entry{id=29,dest={73756273656374696F6E2E342E33},srcline={9}}{50736575646F20636F6465206465736372697074696F6E}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The autocorrelation function $S_{\hat  {O}}(t_{\textrm  {QMC}})$ (a) and the scaling of the error with effective bin size (b) of three equal-time, spin-spin correlation functions $\hat  {O}$ of the Hubbard model in the $M_z$ decoupling (see Sec.\nobreakspace  {}\ref  {sec:walk1.1}). Simulations were done on a $ 6 \times 6$ square lattice, with $U/t=4$ and $\beta t = 6$. The original bin contained only one sweep and we calculated around one million bins on a single core. The different autocorrelation times for the $xy$-plane compared to the $z$-direction can be detected from the decay rate of the autocorrelation function (a) and from the point where saturation of the error sets in (b), which defines the required effective bin size for independent measurements. The improved estimator $(S_{\hat  {S}^{x}} + S_{\hat  {S}^{y}}+ S_{\hat  {S}^{z}})/3$ appears to have the smallest autocorrelation time, as argued in the text.}}{26}{figure.4}\protected@file@percent }
\newlabel{fig_autocorr}{{4}{26}{The autocorrelation function $S_{\hat {O}}(t_{\textrm {QMC}})$ (a) and the scaling of the error with effective bin size (b) of three equal-time, spin-spin correlation functions $\hat {O}$ of the Hubbard model in the $M_z$ decoupling (see Sec.~\ref {sec:walk1.1}). Simulations were done on a $ 6 \times 6$ square lattice, with $U/t=4$ and $\beta t = 6$. The original bin contained only one sweep and we calculated around one million bins on a single core. The different autocorrelation times for the $xy$-plane compared to the $z$-direction can be detected from the decay rate of the autocorrelation function (a) and from the point where saturation of the error sets in (b), which defines the required effective bin size for independent measurements. The improved estimator $(S_{\hat {S}^{x}} + S_{\hat {S}^{y}}+ S_{\hat {S}^{z}})/3$ appears to have the smallest autocorrelation time, as argued in the text}{figure.4}{}}
